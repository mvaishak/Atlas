# Build is deliberately separate from private read-only artifact mounts.
FROM ghcr.io/astral-sh/uv:0.8.22@sha256:9874eb7afe5ca16c363fe80b294fe700e460df29a55532bbfea234a0f12eddb1 AS uv
FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never UV_COMPILE_BYTECODE=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 CUDA_VISIBLE_DEVICES="" \
    PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app
COPY pyproject.toml uv.lock README.md MANIFEST.in ./
COPY src ./src
COPY scripts/serve_bundle.py ./scripts/serve_bundle.py
# Linux Torch resolves to the CPU-only wheel source declared in pyproject/uv.lock.
RUN uv sync --locked --no-dev --no-editable && \
    useradd --create-home --uid 10001 atlas && chown -R atlas:atlas /app
USER atlas
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=2s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready',timeout=1)"
ENTRYPOINT ["python", "scripts/serve_bundle.py", "--container"]
CMD ["--descriptor", "/bundles/descriptor", "--artifacts", "/bundles/artifacts"]
