include uv.lock
recursive-include configs *.json
recursive-include tests/fixtures *.json
recursive-include environments *.json *.txt
recursive-include notebooks *.ipynb
recursive-include scripts *.py *.sh
recursive-include docs *.md
recursive-include src/atlasrank/serving/static *.html *.css
prune .local
prune results
prune Colab*
prune .hallmark
prune docs/superpowers
exclude docs/reviews/*.json
global-exclude *.py[cod] *.log *.parquet *.npy *.npz *.pt *.safetensors *.faiss *.ubj
